# Copy to .env and adjust for your environment.
# SQLite is the default (zero-config). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/ml_platform
DATABASE_URL=sqlite:///./ml_platform.db

# JWT secrets — change in production!
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed CORS origins (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML pipeline defaults
DEFAULT_TEST_SIZE=0.2
DEFAULT_RANDOM_STATE=42

# Email OTP verification via SMTP.
# Leave SMTP_HOST empty to run in DEV mode: the OTP code is returned in the API
# response so you can verify accounts without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# OTP behaviour
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
